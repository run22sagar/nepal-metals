SITE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Enable only while your Metals.Dev subscription and display rights are active.
METALS_API_KEY=
METALS_LICENSE_ACTIVE=false
METALS_HISTORY_ALLOWED=false
# At 30-minute intervals: approximately 1,488 calls/month (plus retries).
METALS_CACHE_SECONDS=1800
CRON_SECRET=
# node scripts/generate-secrets.mjs writes local ignored secrets; never commit them.
SUBSCRIPTION_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-your-operations-email@example.com
ALERT_HOUR_NEPAL=9
# Comma-separated approved RSS hosts. Empty disables remote news retrieval.
NEWS_ALLOWED_HOSTS=
# Optional cookieless Plausible analytics. Disabled until configured.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
GOOGLE_SITE_VERIFICATION=
